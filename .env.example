# MAX Bot API token (never commit the real value)
MAX_BOT_TOKEN=your_max_bot_token

# OpenAI or another OpenAI-compatible cloud API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_cloud_api_key
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=180
LLM_MAX_TOKENS=1200
# Set true only for a local llama.cpp/Qwen endpoint.
LLM_LOCAL_MODE=false

# Cloud embeddings. Keep 1024 dimensions: PostgreSQL uses vector(1024).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_cloud_api_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_TIMEOUT=180
# Lexical search is ready immediately. Enable after running the optional indexer.
ENABLE_VECTOR_SEARCH=false

# Docker Compose database settings
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=max_courses
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=replace_with_generated_password
# Used only by legacy local migration scripts
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace_with_generated_password
