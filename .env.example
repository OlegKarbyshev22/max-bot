# MAX Bot API token (never commit the real value)
MAX_BOT_TOKEN=your_max_bot_token

# Local Ling Tiny service from docker-compose.yml.
LLM_BASE_URL=http://llm:8080/v1
LLM_API_KEY=local
LLM_MODEL=inclusionai/ling-3.0-tiny-q4_k_m
LLM_TIMEOUT=300
LLM_MAX_TOKENS=1200
# Ling Tiny is served by local llama.cpp.
LLM_LOCAL_MODE=false
# JSON is prompted and validated by Pydantic.
LLM_USE_JSON_SCHEMA=false

# Local Qwen3 Embedding 0.6B service. It produces 1024-dimensional vectors.
EMBEDDING_BASE_URL=http://embeddings:8080/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_TIMEOUT=180
# Lexical search is ready immediately. Enable after running the optional indexer.
ENABLE_VECTOR_SEARCH=false

# Docker Compose database settings
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=max_courses
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=replace_with_generated_password
# Used only by legacy local migration scripts
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace_with_generated_password
